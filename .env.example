# Optional: set this if Blender auto-detection fails.
# Windows example:
# BLENDER_EXECUTABLE=C:\Program Files\Blender Foundation\Blender 5.0\blender.exe
# macOS example:
# BLENDER_EXECUTABLE=/Applications/Blender.app/Contents/MacOS/Blender
# Linux example:
# BLENDER_EXECUTABLE=/usr/bin/blender
BLENDER_EXECUTABLE=

# Optional: override when the MCP add-on installer cannot discover Blender's add-ons directory.
# Windows example:
# BLENDER_ADDONS_PATH=%APPDATA%\Blender Foundation\Blender\5.0\scripts\addons
BLENDER_ADDONS_PATH=

PYTHONUNBUFFERED=1
